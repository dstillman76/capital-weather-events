    {
      "id": 78935,
      "title": "Transportation and Mobility Commission Meeting",
      "url": "https://www.rockvillemd.gov/calendar/meetings/transportation-and-mobility-commission-monthly-meeting-3-2-8",
      "start_date": "2026-10-27 19:00:00",
      "end_date": "2026-10-27 21:00:00",
      "all_day": false,
      "description": "<p>The Transportation and Mobility Commission meets monthly to discuss transportation issues and opportunities in Rockville. The members of the commission are appointed by the Mayor and Council.</p>\n<p>All residents and interested stakeholders are welcome to attend commission meetings and may raise transportation-related concerns with the commission members.</p>\n<p>The commission meets virtually on the fourth Tuesday of every month, unless otherwise specified.</p>\n<p style=\"color: white; height: 0;\">.</p>",
