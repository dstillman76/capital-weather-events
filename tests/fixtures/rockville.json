    {
      "id": 65149,
      "title": "Mayor and Council Drop-In Meeting &#8211; Mayor Ashton and CM Valeri",
      "url": "https://www.rockvillemd.gov/calendar/meetings/mayor-and-council-drop-in-meeting-mayor-ashton-and-cm-fulton-2",
      "start_date": "2026-10-26 17:15:00",
      "end_date": "2026-10-26 18:15:00",
      "all_day": false,
      "description": "<p>Drop-in meetings are held before the second\u00a0<a href=\"https://www.rockvillemd.gov/departments/mayor-and-council/\">Mayor and Council</a> meeting of every month in the Mayor and Council office at <a href=\"https://www.rockvillemd.gov/places/rockville-city-hall/\">Rockville City Hall</a> with the mayor and a councilmember. Community members are able to speak in person or by phone with the mayor and/or councilmember for generally up to 10 minutes on any topic. Drop-in meeting appointments must be submitted by 10 a.m. on the day of the meeting.</p>\n<p style=\"color: white; height: 0;\">.</p>",
